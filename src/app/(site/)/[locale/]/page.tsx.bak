                      <h3 className="font-bold text-white truncate group-hover:text-purple-400 transition-colors text-lg drop-shadow-lg">
                        {product.name}
                      </h3>
                      <div className="flex items-center justify-between mt-4 pt-4 border-t border-gray-800">
