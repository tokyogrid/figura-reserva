                <div className="relative p-2 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-xl">
                  <span className="h-6 w-6 text-white">\u2728</span>
                </div>
                <div>
                  <h2 className="text-3xl font-bold text-white">Figuras destacadas</h2>
                  <p className="text-gray-400">Las m\u00e1s reservadas esta semana</p>
                </div>
              </div>
              <a href="/catalogo" className="hidden md:flex items-center gap-2 text-purple-400 hover:text-pink-400 font-medium transition-colors">
                Ver todas <svg className="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
              </a>
            </div>

            <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              {featuredProducts.map((product, index) => (
                <ProductCard key={product.id} product={{
                  ...product,
                  releaseDate: product.releaseDate ? product.releaseDate.toISOString() : null,
                  createdAt: product.createdAt.toISOString(),
                  updatedAt: product.updatedAt.toISOString(),
                }} className="animate-slide-up" style={{ animationDelay: `${index * 100}ms` }} />
              ))}
            </div>
          </div>
        </section>
      )}

      {/* CTA */}
      <section className="relative z-10 py-16 lg:py-24 overflow-hidden animate-fade-in">
        <div className="absolute inset-0 bg-gradient-to-r from-purple-500/5 via-transparent to-pink-500/5" />
        <div className="container">
          <div className="relative overflow-hidden bg-gradient-to-br from-purple-600 via-purple-700 to-pink-700 text-white border-purple-500/30 animate-slide-up">
            <div className="absolute top-0 right-0 w-72 h-72 bg-yellow-400/20 rounded-full blur-3xl animate-pulse-slow" />
            <div className="absolute bottom-0 left-0 w-72 h-72 bg-cyan-400/20 rounded-full blur-3xl animate-pulse-slow delay-1000" />
            <div className="p-8 md:p-12 text-center relative z-10">
              <div className="inline-flex h-16 w-16 items-center justify-center rounded-full bg-white/10 mb-4 group animate-pulse-slow">
                <svg className="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></svg>
              </div>
              <h2 className="text-3xl sm:text-4xl font-bold mb-4">{tCta('cantFindTitle')}</h2>
