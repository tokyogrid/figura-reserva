            </div>
            <h2 className="text-3xl sm:text-4xl font-bold text-white mb-4">{tHowItWorks('title')}</h2>
            <p className="text-gray-400">{tHowItWorks('subtitle')}</p>
          </div>

          <div className="grid md:grid-cols-3 gap-6">
