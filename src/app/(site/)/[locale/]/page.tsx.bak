              { name: "One Piece", character: "Monkey D. Luffy", image: "/images/anime/luffy.webp", series: "One Piece" },
              { name: "Jujutsu Kaisen", character: "Satoru Gojo", image: "/images/anime/gojo.webp", series: "Jujutsu Kaisen" },
              { name: "Demon Slayer", character: "Tanjiro Kamado", image: "/images/anime/tanjiro.webp", series: "Demon Slayer" },
